.{
    .input_device_rules = .{
        .{ .repeat_info = .{ .rate = 50, .delay = 200 } },
    },

    .xkb_keyboard_rules = .{
        .{
            .name = .{ .str = ".*GMMK.*", .regex = true },
            .layout = .{ .name = "eu" },
            // .keymap = .{
            //     .options = .{ .layout = "eu" },
            // },
        },
    },
}
